{
  "description": "Stop secrets (API keys, private keys, tokens) from being sent in a prompt.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-secrets.mjs\"", "timeout": 10 }
        ]
      }
    ]
  }
}
